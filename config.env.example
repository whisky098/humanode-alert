# Telegram bot token from @BotFather
TELEGRAM_TOKEN=
# Code to send with /register, so that only you can claim the bot (install.sh generates it)
REGISTER_CODE=
# JSON-RPC endpoint of the local Humanode node. If it does not respond at startup,
# 127.0.0.1:9944 and 127.0.0.1:9933 are tried and you get a message in Telegram
RPC_URL=http://127.0.0.1:9933
# Humanode workspace with humanode-peer, humanode-websocket-tunnel and chainspec.json,
# used by /get_bioauth_link
HUMANODE_WORKSPACE=/root/.humanode/workspaces/default
# Reminders this many minutes before BioAuth expires, each sent once
WARN_MINUTES=60,30,5,3,1
# While BioAuth is expired or the node is down, repeat the alert every N minutes
ALERT_REPEAT_MINUTES=5
